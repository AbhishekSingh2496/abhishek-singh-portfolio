# Public URL of the deployed site (no trailing slash). Used for Open Graph / Twitter image URLs.
VITE_SITE_URL=

# Optional: endpoint that accepts a JSON POST { name, email, message }.
# Works with Formspree (https://formspree.io/f/xxxx) or your own backend.
# Leave empty and the contact form will fall back to opening the visitor's email app.
VITE_CONTACT_ENDPOINT=
